# ───────── Core ─────────
# Secret used for HMAC (consent signatures, PAN/Aadhaar/mobile tokenization). CHANGE THIS.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL: leave unset to use the default (backend/data/saksham.db, resolved as an absolute
# path in core/config.py). Set it only to point at a different file or a non-SQLite URL.
# Public HTTPS origin reachable from a real phone (e.g. `ngrok http 8000`). Never localhost for the demo.
PUBLIC_BASE_URL=http://localhost:8000
# Base URL the backend uses to call its own /mock/* services over HTTP
MOCK_SERVICES_BASE_URL=http://localhost:8000
# Origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ───────── Messaging ─────────
# whatsapp | simulated | both   (the outbox is always written, whatever the mode)
MESSAGING_MODE=simulated
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=129924074327097
WHATSAPP_BUSINESS_ACCOUNT_ID=106611522633989
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=saksham-verify-token
# Optional: enables X-Hub-Signature-256 checks on inbound webhooks
WHATSAPP_APP_SECRET=
# Real sends are redirected to this verified number (personas have fake numbers)
DEMO_RECIPIENT_NUMBER=
# Number shown on the consent page's wa.me deep link (digits only, with country code)
WHATSAPP_BUSINESS_NUMBER=15556697571
# Template used for the consent request. Switch to your approved custom template once available.
WHATSAPP_CONSENT_TEMPLATE=hello_world
WHATSAPP_CONSENT_TEMPLATE_LANG=en_US        # or "auto" → en/hi/mr by applicant language
WHATSAPP_CONSENT_TEMPLATE_PARAMS=            # placeholders to send as body variables, e.g. name,url  (empty for hello_world)
# Optional: template for decisions when the 24h window is closed (leave empty → not sent for real; stays in the dashboard's message log)
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_STATUS_TEMPLATE_LANG=en_US
WHATSAPP_STATUS_TEMPLATE_PARAMS=name,url

# ───────── LLM advisory (Google Gemini) ─────────
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=6
# true → never call the LLM, always use deterministic templates (offline mode)
LLM_FALLBACK_ONLY=false

# ───────── Demo ─────────
DEMO_DEALER_NAME=dealer_01
